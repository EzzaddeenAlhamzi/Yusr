# --- Secrets & local env (P1.0) ---
# Never commit real credentials. Keep .env.example tracked.
.env
.env.*
!.env.example
!**/.env.example
# P2.4 CARTO Free API key (use dart_defines.json.example as template).
dart_defines.json
**/carto_api_key.local.dart
*.pem
!backend/cacert.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials.json
service-account*.json
google-services.json
GoogleService-Info.plist

# --- SQL dumps & backups (future + local) ---
# NOTE: .gitignore does NOT untrack files already in git history.
# Tracked dump yusr_application_backup.sql remains until a separate PO
# deletion / history decision (PO-D02). Do NOT git rm without PO approval.
*.sql
*.sql.gz
*.sql.bz2
*.sql.xz
*.sql.zip
*.dump
*.bak
*.legacy_backup
*backup*.sql
*_backup.sql

