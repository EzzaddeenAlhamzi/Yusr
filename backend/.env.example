APP_NAME=Yusr
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Lab serve port: prefer 8088 so YOGC/other apps can keep :8000 (P1.1 kickoff).
APP_URL=http://127.0.0.1:8088

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Isolated lab MySQL only — NEVER point at a shared/public host.
# NEVER import the public GitHub SQL dump as a seed (PO-D01 residual risk; PO-D17).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yusr_lab
DB_USERNAME=yusr_lab_user
DB_PASSWORD=replace_with_local_lab_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum / auth hardening is OUT OF SCOPE for P1.0 (starts P1.1+).
# Placeholders only — do not expose this API on public networks (PO-D04).
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:8088

# Optional AI integrations — leave empty in lab unless using local mocks.
GEMINI_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
