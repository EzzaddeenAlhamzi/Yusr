<?php
/**
 * أصل الصفحة الرئيسية للتطبيق (Main API Entrypoint)
 * يستدعي ملف الاتصال بقاعدة البيانات db.php
 * ويتعامل مع جداول قاعدة البيانات yusr_application بدون أي تعديل عليها
 */

require_once 'db.php';

header('Content-Type: application/json; charset=utf-8');
header('Access-Control-Allow-Origin: *');
header('Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS');
header('Access-Control-Allow-Headers: Content-Type, Authorization, X-Requested-With');

if (($_SERVER['REQUEST_METHOD'] ?? 'GET') === 'OPTIONS') {
    http_response_code(200);
    exit;
}

// قراءة بيانات الطلب (سواء JSON أو POST/GET)
$inputJSON = file_get_contents('php://input');
$requestData = json_decode($inputJSON, true) ?? [];
$action = $_GET['action'] ?? $requestData['action'] ?? $_POST['action'] ?? 'ping';

try {
    switch ($action) {
        // 1. فحص الاتصال بقاعدة البيانات
        case 'ping':
            echo json_encode([
                'status' => 'success',
                'message' => 'تم الاتصال بقاعدة البيانات yusr_application بنجاح!',
                'database' => $dbname,
                'charset' => $charset
            ], JSON_UNESCAPED_UNICODE);
            break;

        // 2. تسجيل مقدم الرعاية (جدول caregivers)
        case 'register_caregiver':
            $name = trim($requestData['C_Name'] ?? $_POST['C_Name'] ?? '');
            $phone = trim($requestData['C_PhonNumber'] ?? $_POST['C_PhonNumber'] ?? '');
            $relationship = trim($requestData['C_Relationship'] ?? $_POST['C_Relationship'] ?? '');
            $email = trim($requestData['C_Email'] ?? $_POST['C_Email'] ?? '');
            $password = trim($requestData['C_Password'] ?? $_POST['C_Password'] ?? '');

            if (empty($name) || (empty($phone) && empty($email))) {
                http_response_code(400);
                echo json_encode(['status' => 'error', 'message' => 'الاسم ورقم الهاتف أو البريد الإلكتروني مطلوبان'], JSON_UNESCAPED_UNICODE);
                break;
            }

            if (!empty($phone)) {
                $stmt = $pdo->prepare("SELECT * FROM caregivers WHERE C_PhonNumber = ?");
                $stmt->execute([$phone]);
                if ($stmt->fetch()) {
                    http_response_code(409);
                    echo json_encode(['status' => 'error', 'message' => 'رقم الهاتف مسجل بالفعل لمقدم رعاية في قاعدة البيانات'], JSON_UNESCAPED_UNICODE);
                    break;
                }
            }

            if (!empty($email)) {
                $stmt = $pdo->prepare("SELECT * FROM caregivers WHERE C_Email = ?");
                $stmt->execute([$email]);
                if ($stmt->fetch()) {
                    http_response_code(409);
                    echo json_encode(['status' => 'error', 'message' => 'البريد الإلكتروني مسجل بالفعل لمقدم رعاية في قاعدة البيانات'], JSON_UNESCAPED_UNICODE);
                    break;
                }
            }

            $idStmt = $pdo->query("SELECT IFNULL(MAX(Caregivers_ID), 0) + 1 AS next_id FROM caregivers");
            $nextId = (int)$idStmt->fetch()['next_id'];

            // حفظ اسم المستخدم والبيانات مباشرة بدون تشفير
            $insertStmt = $pdo->prepare("INSERT INTO caregivers (Caregivers_ID, C_Name, C_PhonNumber, C_Relationship, C_Email, C_Password) VALUES (?, ?, ?, ?, ?, ?)");
            $insertStmt->execute([$nextId, $name, $phone, $relationship, $email, $password]);

            echo json_encode([
                'status' => 'success',
                'message' => 'تم إنشاء حساب مقدم الرعاية بنجاح',
                'caregiver' => [
                    'Caregivers_ID' => $nextId,
                    'C_Name' => $name,
                    'C_PhonNumber' => $phone,
                    'C_Relationship' => $relationship,
                    'C_Email' => $email,
                    'Eldery_ID' => null
                ]
            ], JSON_UNESCAPED_UNICODE);
            break;

        case 'login_caregiver':
            $identifier = trim($requestData['C_PhonNumber'] ?? $requestData['identifier'] ?? $requestData['C_Email'] ?? $_POST['C_PhonNumber'] ?? $_POST['C_Email'] ?? '');
            $password = trim($requestData['C_Password'] ?? $_POST['C_Password'] ?? '');
            if (empty($identifier)) {
                http_response_code(400);
                echo json_encode(['status' => 'error', 'message' => 'يرجى إدخال رقم الهاتف أو البريد الإلكتروني'], JSON_UNESCAPED_UNICODE);
                break;
            }

            $stmt = $pdo->prepare("SELECT * FROM caregivers WHERE C_PhonNumber = ? OR C_Email = ?");
            $stmt->execute([$identifier, $identifier]);
            $caregiver = $stmt->fetch();

            if ($caregiver) {
                echo json_encode([
                    'status' => 'success',
                    'message' => 'تم تسجيل الدخول بنجاح',
                    'role' => 'caregiver',
                    'caregiver' => $caregiver
                ], JSON_UNESCAPED_UNICODE);
            } else {
                http_response_code(404);
                echo json_encode(['status' => 'error', 'message' => 'رقم الهاتف أو البريد غير مسجل كمقدم رعاية في قاعدة البيانات'], JSON_UNESCAPED_UNICODE);
            }
            break;

        
        // استرجاع بيانات مقدم الرعاية
        case 'get_caregiver':
            $caregiverId = $requestData['Caregivers_ID'] ?? $_GET['Caregivers_ID'] ?? null;
            if ($caregiverId) {
                $stmt = $pdo->prepare("SELECT Caregivers_ID, C_Name, C_PhonNumber, C_Relationship, C_Email, Eldery_ID FROM caregivers WHERE Caregivers_ID = ?");
                $stmt->execute([$caregiverId]);
                $caregiver = $stmt->fetch();
                if ($caregiver) {
                    echo json_encode(['status' => 'success', 'data' => $caregiver], JSON_UNESCAPED_UNICODE);
                } else {
                    http_response_code(404);
                    echo json_encode(['status' => 'error', 'message' => 'مقدم الرعاية غير مسجل'], JSON_UNESCAPED_UNICODE);
                }
            } else {
                http_response_code(400);
                echo json_encode(['status' => 'error', 'message' => 'معرف مقدم الرعاية مطلوب'], JSON_UNESCAPED_UNICODE);
            }
            break;

        // تحديث بيانات مقدم الرعاية
        case 'update_caregiver':
            $caregiverId = $requestData['Caregivers_ID'] ?? $_POST['Caregivers_ID'] ?? null;
            $name = trim($requestData['C_Name'] ?? $_POST['C_Name'] ?? '');
            $phone = trim($requestData['C_PhonNumber'] ?? $_POST['C_PhonNumber'] ?? '');
            $relationship = trim($requestData['C_Relationship'] ?? $_POST['C_Relationship'] ?? '');
            $email = trim($requestData['C_Email'] ?? $_POST['C_Email'] ?? '');

            if (!$caregiverId) {
                http_response_code(400);
                echo json_encode(['status' => 'error', 'message' => 'معرف مقدم الرعاية مطلوب'], JSON_UNESCAPED_UNICODE);
                break;
            }

            $stmt = $pdo->prepare("UPDATE caregivers SET C_Name = ?, C_PhonNumber = ?, C_Relationship = ?, C_Email = ? WHERE Caregivers_ID = ?");
            $stmt->execute([$name, $phone, $relationship, $email, $caregiverId]);

            echo json_encode([
                'status' => 'success',
                'message' => 'تم تحديث بيانات مقدم الرعاية بنجاح',
                'caregiver' => [
                    'Caregivers_ID' => $caregiverId,
                    'C_Name' => $name,
                    'C_PhonNumber' => $phone,
                    'C_Relationship' => $relationship,
                    'C_Email' => $email
                ]
            ], JSON_UNESCAPED_UNICODE);
            break;

        case 'register_elderly':
            $name = trim($requestData['E_Name'] ?? $_POST['E_Name'] ?? '');
            $sex = trim($requestData['E_sex'] ?? $_POST['E_sex'] ?? 'ذكر');
            $phone = trim($requestData['E_PhonNumber'] ?? $_POST['E_PhonNumber'] ?? '');
            $email = trim($requestData['E_Email'] ?? $_POST['E_Email'] ?? '');
            $password = trim($requestData['E_Password'] ?? $_POST['E_Password'] ?? '');

            if (empty($name)) {
                http_response_code(400);
                echo json_encode(['status' => 'error', 'message' => 'يرجى إدخال اسم كبير السن'], JSON_UNESCAPED_UNICODE);
                break;
            }

            if (!empty($phone)) {
                $stmt = $pdo->prepare("SELECT * FROM elderly WHERE E_PhonNumber = ?");
                $stmt->execute([$phone]);
                if ($stmt->fetch()) {
                    http_response_code(409);
                    echo json_encode(['status' => 'error', 'message' => 'رقم الهاتف مسجل بالفعل لكبير سن في قاعدة البيانات'], JSON_UNESCAPED_UNICODE);
                    break;
                }
            }

            if (!empty($email)) {
                $stmt = $pdo->prepare("SELECT * FROM elderly WHERE E_Email = ?");
                $stmt->execute([$email]);
                if ($stmt->fetch()) {
                    http_response_code(409);
                    echo json_encode(['status' => 'error', 'message' => 'البريد الإلكتروني مسجل بالفعل لكبير سن في قاعدة البيانات'], JSON_UNESCAPED_UNICODE);
                    break;
                }
            }

            $idStmt = $pdo->query("SELECT IFNULL(MAX(Eldery_ID), 0) + 1 AS next_id FROM elderly");
            $nextId = (int)$idStmt->fetch()['next_id'];

            // حفظ الاسم صريحاً بدون أي تشفير
            $insertStmt = $pdo->prepare("INSERT INTO elderly (Eldery_ID, E_Name, E_sex, E_PhonNumber, E_Email, E_Password) VALUES (?, ?, ?, ?, ?, ?)");
            $insertStmt->execute([$nextId, $name, $sex, $phone, $email, $password]);

            echo json_encode([
                'status' => 'success',
                'message' => 'تم إنشاء حساب كبير السن بنجاح',
                'elderly' => [
                    'Eldery_ID' => $nextId,
                    'E_Name' => $name,
                    'E_sex' => $sex,
                    'E_PhonNumber' => $phone,
                    'E_Email' => $email
                ]
            ], JSON_UNESCAPED_UNICODE);
            break;

        case 'login_elderly':
            $identifier = trim($requestData['E_PhonNumber'] ?? $requestData['identifier'] ?? $requestData['E_Email'] ?? $_POST['E_PhonNumber'] ?? $_POST['E_Email'] ?? '');
            $password = trim($requestData['E_Password'] ?? $requestData['password'] ?? $_POST['E_Password'] ?? $_POST['password'] ?? '');
            if (empty($identifier)) {
                http_response_code(400);
                echo json_encode(['status' => 'error', 'message' => 'يرجى إدخال رقم الهاتف أو البريد الإلكتروني'], JSON_UNESCAPED_UNICODE);
                break;
            }

            $stmt = $pdo->prepare("SELECT * FROM elderly WHERE E_PhonNumber = ? OR E_Email = ?");
            $stmt->execute([$identifier, $identifier]);
            $senior = $stmt->fetch();

            if ($senior) {
                if (!empty($password) && !empty($senior['E_Password']) && $senior['E_Password'] !== $password) {
                    http_response_code(401);
                    echo json_encode(['status' => 'error', 'message' => 'كلمة المرور غير صحيحة لكبير السن'], JSON_UNESCAPED_UNICODE);
                    break;
                }
                echo json_encode([
                    'status' => 'success',
                    'message' => 'تم تسجيل دخول كبير السن بنجاح',
                    'role' => 'senior',
                    'elderly' => $senior
                ], JSON_UNESCAPED_UNICODE);
            } else {
                http_response_code(404);
                echo json_encode(['status' => 'error', 'message' => 'رقم الهاتف أو البريد غير مسجل لكبير سن في قاعدة البيانات'], JSON_UNESCAPED_UNICODE);
            }
            break;

        case 'forgot_password':
            $email = trim($requestData['email'] ?? $_POST['email'] ?? '');
            $role = trim($requestData['role'] ?? $_POST['role'] ?? '');

            if (empty($email)) {
                http_response_code(400);
                echo json_encode(['status' => 'error', 'message' => 'يرجى إدخال البريد الإلكتروني للتواصل'], JSON_UNESCAPED_UNICODE);
                break;
            }

            echo json_encode([
                'status' => 'success',
                'message' => 'تم استلام طلبك، وسيتم التواصل معك عبر البريد الإلكتروني لإعادة تعيين كلمة المرور.',
                'email' => $email
            ], JSON_UNESCAPED_UNICODE);
            break;

        case 'get_elderly':
            $id = $requestData['Eldery_ID'] ?? $_GET['Eldery_ID'] ?? null;
            if ($id) {
                $stmt = $pdo->prepare("SELECT * FROM elderly WHERE Eldery_ID = ?");
                $stmt->execute([$id]);
                $data = $stmt->fetch();
                if ($data) {
                    $cgStmt = $pdo->prepare("SELECT Caregivers_ID, C_Name, C_PhonNumber, C_Relationship, C_Email FROM caregivers WHERE Eldery_ID = ? LIMIT 1");
                    $cgStmt->execute([$id]);
                    $data['caregiver'] = $cgStmt->fetch() ?: null;
                }
            } else {
                $stmt = $pdo->query("SELECT * FROM elderly ORDER BY Eldery_ID ASC");
                $data = $stmt->fetchAll();
            }
            echo json_encode(['status' => 'success', 'data' => $data], JSON_UNESCAPED_UNICODE);
            break;

        // 7. تحديث بيانات كبير السن
        case 'update_elderly':
            $id = $requestData['Eldery_ID'] ?? $_POST['Eldery_ID'] ?? null;
            $name = trim($requestData['E_Name'] ?? $_POST['E_Name'] ?? '');
            $sex = trim($requestData['E_sex'] ?? $_POST['E_sex'] ?? '');
            $phone = trim($requestData['E_PhonNumber'] ?? $_POST['E_PhonNumber'] ?? '');

            if (!$id) {
                http_response_code(400);
                echo json_encode(['status' => 'error', 'message' => 'معرف كبير السن مطلوب'], JSON_UNESCAPED_UNICODE);
                break;
            }

            $stmt = $pdo->prepare("UPDATE elderly SET E_Name = ?, E_sex = ?, E_PhonNumber = ? WHERE Eldery_ID = ?");
            $stmt->execute([$name, $sex, $phone, $id]);

            echo json_encode(['status' => 'success', 'message' => 'تم تحديث بيانات كبير السن بنجاح'], JSON_UNESCAPED_UNICODE);
            break;

        // 8. ربط مقدم الرعاية بكبير السن
        case 'link_elderly':
            $caregiverId = $requestData['Caregivers_ID'] ?? $_POST['Caregivers_ID'] ?? null;
            $elderlyId = $requestData['Eldery_ID'] ?? $_POST['Eldery_ID'] ?? null;

            if (!$caregiverId || !$elderlyId) {
                http_response_code(400);
                echo json_encode(['status' => 'error', 'message' => 'معرف مقدم الرعاية ومعرف كبير السن مطلوبان'], JSON_UNESCAPED_UNICODE);
                break;
            }

            $stmt = $pdo->prepare("UPDATE caregivers SET Eldery_ID = ? WHERE Caregivers_ID = ?");
            $stmt->execute([$elderlyId, $caregiverId]);

            echo json_encode(['status' => 'success', 'message' => 'تم ربط الحساب بكبير السن بنجاح'], JSON_UNESCAPED_UNICODE);
            break;

        // 9. الأدوية (جدول medications)
        case 'get_medications':
            $elderlyId = $requestData['Elderly_ID'] ?? $_GET['Elderly_ID'] ?? null;
            if ($elderlyId) {
                $stmt = $pdo->prepare("SELECT * FROM medications WHERE Elderly_ID = ? ORDER BY Medicayion_ID DESC");
                $stmt->execute([$elderlyId]);
            } else {
                $stmt = $pdo->query("SELECT * FROM medications ORDER BY Medicayion_ID DESC");
            }
            echo json_encode(['status' => 'success', 'data' => $stmt->fetchAll()], JSON_UNESCAPED_UNICODE);
            break;

        case 'add_medication':
            $name = trim($requestData['M_Name'] ?? $_POST['M_Name'] ?? '');
            $dose = trim($requestData['M_much'] ?? $_POST['M_much'] ?? '');
            $repeat = trim($requestData['M_RepatTime'] ?? $_POST['M_RepatTime'] ?? '');
            $elderlyId = $requestData['Elderly_ID'] ?? $_POST['Elderly_ID'] ?? null;

            if (empty($name)) {
                http_response_code(400);
                echo json_encode(['status' => 'error', 'message' => 'اسم الدواء مطلوب'], JSON_UNESCAPED_UNICODE);
                break;
            }

            $idStmt = $pdo->query("SELECT IFNULL(MAX(Medicayion_ID), 0) + 1 AS next_id FROM medications");
            $nextId = (int)$idStmt->fetch()['next_id'];

            $stmt = $pdo->prepare("INSERT INTO medications (Medicayion_ID, M_Name, M_much, M_RepatTime, Elderly_ID) VALUES (?, ?, ?, ?, ?)");
            $stmt->execute([$nextId, $name, $dose, $repeat, $elderlyId]);

            echo json_encode(['status' => 'success', 'message' => 'تمت إضافة الدواء بنجاح', 'id' => $nextId], JSON_UNESCAPED_UNICODE);
            break;

        case 'delete_medication':
            $id = $requestData['Medicayion_ID'] ?? $_POST['Medicayion_ID'] ?? null;
            if ($id) {
                $stmt = $pdo->prepare("DELETE FROM medications WHERE Medicayion_ID = ?");
                $stmt->execute([$id]);
                echo json_encode(['status' => 'success', 'message' => 'تم حذف الدواء بنجاح'], JSON_UNESCAPED_UNICODE);
            } else {
                http_response_code(400);
                echo json_encode(['status' => 'error', 'message' => 'معرف الدواء مطلوب للحذف'], JSON_UNESCAPED_UNICODE);
            }
            break;

        // 10. المواعيد (جدول appointments)
        case 'get_appointments':
            $elderlyId = $requestData['Elderly_ID'] ?? $_GET['Elderly_ID'] ?? null;
            if ($elderlyId) {
                $stmt = $pdo->prepare("SELECT * FROM appointments WHERE Elderly_ID = ? ORDER BY A_Date ASC, A_Time ASC");
                $stmt->execute([$elderlyId]);
            } else {
                $stmt = $pdo->query("SELECT * FROM appointments ORDER BY A_Date ASC, A_Time ASC");
            }
            echo json_encode(['status' => 'success', 'data' => $stmt->fetchAll()], JSON_UNESCAPED_UNICODE);
            break;

        case 'add_appointment':
            $time = $requestData['A_Time'] ?? $_POST['A_Time'] ?? null;
            $date = $requestData['A_Date'] ?? $_POST['A_Date'] ?? null;
            $type = trim($requestData['A_DateType'] ?? $_POST['A_DateType'] ?? '');
            $location = trim($requestData['A_Location'] ?? $_POST['A_Location'] ?? '');
            $note = trim($requestData['A_Note'] ?? $_POST['A_Note'] ?? '');
            $elderlyId = $requestData['Elderly_ID'] ?? $_POST['Elderly_ID'] ?? null;

            $idStmt = $pdo->query("SELECT IFNULL(MAX(Appointment_ID), 0) + 1 AS next_id FROM appointments");
            $nextId = (int)$idStmt->fetch()['next_id'];

            $stmt = $pdo->prepare("INSERT INTO appointments (Appointment_ID, A_Time, A_Date, A_DateType, A_Location, A_Note, Elderly_ID) VALUES (?, ?, ?, ?, ?, ?, ?)");
            $stmt->execute([$nextId, $time, $date, $type, $location, $note, $elderlyId]);

            echo json_encode(['status' => 'success', 'message' => 'تمت إضافة الموعد بنجاح', 'id' => $nextId], JSON_UNESCAPED_UNICODE);
            break;

        case 'delete_appointment':
            $id = $requestData['Appointment_ID'] ?? $_POST['Appointment_ID'] ?? null;
            if ($id) {
                $stmt = $pdo->prepare("DELETE FROM appointments WHERE Appointment_ID = ?");
                $stmt->execute([$id]);
                echo json_encode(['status' => 'success', 'message' => 'تم حذف الموعد بنجاح'], JSON_UNESCAPED_UNICODE);
            } else {
                http_response_code(400);
                echo json_encode(['status' => 'error', 'message' => 'معرف الموعد مطلوب للحذف'], JSON_UNESCAPED_UNICODE);
            }
            break;

        // 11. جهات اتصال الطوارئ (جدول emergency_contacts)
        case 'get_emergency_contacts':
            $elderlyId = $requestData['Eldery_ID'] ?? $_GET['Eldery_ID'] ?? null;
            if ($elderlyId) {
                $stmt = $pdo->prepare("SELECT * FROM emergency_contacts WHERE Eldery_ID = ? ORDER BY Priority ASC, contact_ID ASC");
                $stmt->execute([$elderlyId]);
            } else {
                $stmt = $pdo->query("SELECT * FROM emergency_contacts ORDER BY Priority ASC, contact_ID ASC");
            }
            echo json_encode(['status' => 'success', 'data' => $stmt->fetchAll()], JSON_UNESCAPED_UNICODE);
            break;

        case 'add_emergency_contact':
            $name = trim($requestData['contact_Name'] ?? $_POST['contact_Name'] ?? '');
            $phone = trim($requestData['Phone_Number'] ?? $_POST['Phone_Number'] ?? '');
            $rel = trim($requestData['Relationship'] ?? $_POST['Relationship'] ?? '');
            $priority = (int)($requestData['Priority'] ?? $_POST['Priority'] ?? 1);
            $elderlyId = $requestData['Eldery_ID'] ?? $_POST['Eldery_ID'] ?? null;

            if (empty($name) || empty($phone)) {
                http_response_code(400);
                echo json_encode(['status' => 'error', 'message' => 'الاسم ورقم الهاتف مطلوبان لجهة الاتصال'], JSON_UNESCAPED_UNICODE);
                break;
            }

            $idStmt = $pdo->query("SELECT IFNULL(MAX(contact_ID), 0) + 1 AS next_id FROM emergency_contacts");
            $nextId = (int)$idStmt->fetch()['next_id'];

            $stmt = $pdo->prepare("INSERT INTO emergency_contacts (contact_ID, contact_Name, Phone_Number, Relationship, Priority, Eldery_ID) VALUES (?, ?, ?, ?, ?, ?)");
            $stmt->execute([$nextId, $name, $phone, $rel, $priority, $elderlyId]);

            echo json_encode(['status' => 'success', 'message' => 'تمت إضافة جهة اتصال الطوارئ بنجاح', 'id' => $nextId], JSON_UNESCAPED_UNICODE);
            break;

        case 'delete_emergency_contact':
            $id = $requestData['contact_ID'] ?? $_POST['contact_ID'] ?? null;
            if ($id) {
                $stmt = $pdo->prepare("DELETE FROM emergency_contacts WHERE contact_ID = ?");
                $stmt->execute([$id]);
                echo json_encode(['status' => 'success', 'message' => 'تم حذف جهة اتصال الطوارئ بنجاح'], JSON_UNESCAPED_UNICODE);
            } else {
                http_response_code(400);
                echo json_encode(['status' => 'error', 'message' => 'معرف جهة الاتصال مطلوب للحذف'], JSON_UNESCAPED_UNICODE);
            }
            break;

        // 12. الأجهزة (جدول devices)
        case 'get_devices':
            $elderlyId = $requestData['Elderly_ID'] ?? $_GET['Elderly_ID'] ?? null;
            if ($elderlyId) {
                $stmt = $pdo->prepare("SELECT * FROM devices WHERE Elderly_ID = ? ORDER BY Devices_ID DESC");
                $stmt->execute([$elderlyId]);
            } else {
                $stmt = $pdo->query("SELECT * FROM devices ORDER BY Devices_ID DESC");
            }
            echo json_encode(['status' => 'success', 'data' => $stmt->fetchAll()], JSON_UNESCAPED_UNICODE);
            break;

        case 'add_device':
            $type = trim($requestData['D_Type'] ?? $_POST['D_Type'] ?? '');
            $number = trim($requestData['T_Number'] ?? $_POST['T_Number'] ?? '');
            $elderlyId = $requestData['Elderly_ID'] ?? $_POST['Elderly_ID'] ?? null;

            $idStmt = $pdo->query("SELECT IFNULL(MAX(Devices_ID), 0) + 1 AS next_id FROM devices");
            $nextId = (int)$idStmt->fetch()['next_id'];

            $stmt = $pdo->prepare("INSERT INTO devices (Devices_ID, D_Type, T_Number, Elderly_ID) VALUES (?, ?, ?, ?)");
            $stmt->execute([$nextId, $type, $number, $elderlyId]);

            echo json_encode(['status' => 'success', 'message' => 'تمت إضافة الجهاز بنجاح', 'id' => $nextId], JSON_UNESCAPED_UNICODE);
